# Copy to .env (docker compose reads it) and fill in. Never commit .env.

# QBO app (developer.intuit.com > your app > Keys & credentials, Development/sandbox keys)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must also be listed under Redirect URIs on that page, exactly as written here.
QBO_REDIRECT_URI=http://localhost:3000/qbo/callback

# QBO webhooks: the verifier token from the app's Webhooks page. Webhooks need a public
# URL (e.g. a tunnel to localhost:3000/webhooks/qbo); without them the 60 s CDC poll still
# catches every change, so any value works here.
QBO_WEBHOOK_VERIFIER=change-me

# Admin page login (user "admin").
ADMIN_PASSWORD=change-me

# Shared by the Internal System (signs) and the sync service (verifies).
INTERNAL_WEBHOOK_SECRET=change-me

# Internal revenue category -> QBO Item id, payment method -> QBO deposit account id.
# Find the ids with: docker compose run --rm sync node sync/src/cli.ts qbo-ids
ACCOUNT_MAPPING={"revenue_category":{"consulting":"1"},"payment_method":{}}

# Set to 1 to have the Internal System duplicate, delay and reorder its notifications.
CHAOS=0
