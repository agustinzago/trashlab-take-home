# Every setting has a working default: `docker compose up` runs without a .env file,
# against the mock QBO service. Copy this to .env only to change something.

# Sign-in for the web console and the admin page (user "admin"). Change it for anything shared.
ADMIN_PASSWORD=admin

# Shared by the Internal System (signs its notifications) and the sync service (verifies them).
INTERNAL_WEBHOOK_SECRET=dev-internal-secret

# Key for QBO's webhook signatures. The mock QBO signs with this same default; for the real
# sandbox use the verifier token from your app's Webhooks page.
QBO_WEBHOOK_VERIFIER=dev-qbo-verifier

# Internal revenue category -> QBO Item id; payment method -> QBO deposit account id.
# The default matches the mock (Consulting=1, Hosting=2). For the sandbox list the ids with:
#   docker compose run --rm sync node sync/src/cli.ts qbo-ids
ACCOUNT_MAPPING={"revenue_category":{"consulting":"1","hosting":"2"},"payment_method":{}}

# 1 makes the Internal System duplicate, delay and reorder its notifications on purpose.
CHAOS=0

# --- Optional: a real QBO sandbox instead of the mock -------------------------------------
# Uncomment and fill these from developer.intuit.com > your app > Keys & credentials
# (Development). The redirect URI must also be listed there. With QBO_CLIENT_ID set, the
# mock is not used and you connect QBO from the web console.
# QBO_CLIENT_ID=your-development-client-id
# QBO_CLIENT_SECRET=your-development-client-secret
# QBO_REDIRECT_URI=http://localhost:3000/qbo/callback
